# Copy to .env.local and fill in. Nothing here is a secret: a single-page application has none.

# Where the API is, as the browser reaches it. Empty means this origin: in development the Vite server proxies /api to
# MENTOR_API_URL (default http://localhost:5080). A separately hosted API must list this origin in Cors:AllowedOrigins.
VITE_API_BASE_URL=

# Microsoft Entra ID (ADR-002, CONTRACT-ENTRA-IDENTITY), used when the API reports identity mode Entra. The SPA signs in
# with the authorisation code flow with PKCE and calls the API with an access token for the API's scope.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
